# Copy to .env and fill in. Values here are placeholders, safe to commit.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Optional: a Supabase personal access token, if the agent skill / CLI asks for one.
# Create it at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_<...>
