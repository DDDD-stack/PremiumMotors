@model Car
@{
    ViewData["Title"] = "Checkout cancelled";
}

<div class="card shadow-sm mx-auto" style="max-width: 560px;">
    <div class="card-body text-center">
        <div class="display-6 mb-2">🚫</div>
        <h1 class="h4">Checkout cancelled</h1>
        <p class="text-muted">
            No payment was taken@(Model is not null ? $", and \"{Model.Title}\" is still saved as a draft." : ".")
            You can start over whenever you're ready.
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <a asp-action="Create" class="btn btn-primary">List a car</a>
            <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-secondary">Back to auctions</a>
        </div>
    </div>
</div>
