@model Car
@{
    ViewData["Title"] = "Sell your car";
}

<div class="pm-page-head"><h1>Sell your car</h1></div>
@* "Currently free" invited the reading that a charge was coming. It is not: listing is free
   and commission is nothing, and advertising is the only thing anyone ever pays for here. *@
<p class="text-muted">
    List your car for buyers to make private offers. Listing is free, and we take nothing
    when it sells.
</p>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_CarForm" model="Model" />
            <div class="mt-4 d-grid d-sm-flex gap-2">
                <button type="submit" class="btn btn-success">
                    Publish listing
                </button>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
