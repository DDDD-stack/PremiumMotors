@model Car
@inject Microsoft.Extensions.Options.IOptions<WEBTechnologies_Final.Services.ListingOptions> ListingOpts
@{
    ViewData["Title"] = "Sell your car";
    var feeCents = ListingOpts.Value.ListingFeeCents;
    var fee = (feeCents / 100m).ToString("C");
}

<div class="pm-page-head"><h1>Sell your car</h1></div>
<p class="text-muted">
    @if (feeCents > 0)
    {
        <text>List your car for buyers to make private offers. A one-time listing fee of <strong>@fee</strong> is charged before your listing goes live. If your listing gets no offers, your next listing is free.</text>
    }
    else
    {
        <text>List your car for buyers to make private offers. Listings are currently free.</text>
    }
</p>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_CarForm" model="Model" />
            <div class="mt-4 d-grid d-sm-flex gap-2">
                <button type="submit" class="btn btn-success">
                    @(feeCents > 0 ? $"Continue to payment ({fee})" : "Publish listing")
                </button>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
