@model PublicSellerViewModel
@{
    ViewData["Title"] = "Reviews";
}

<div class="pm-page-head">
    <div>
        <h1>Your reviews</h1>
        <p class="pm-muted mb-0 small">
            Left by buyers who completed a purchase from you. You can reply once to each.
        </p>
    </div>
    <partial name="_Stars" model="@((Model.RatingAverage, Model.RatingCount))" />
</div>

<partial name="_ProfileNav" />

@if (Model.Reviews.Count == 0)
{
    <div class="pm-empty">
        <h2 class="h5">No reviews yet</h2>
        <p class="pm-muted mb-0">
            A buyer can review you once you have sold them a car. Nothing to do here except
            keep selling.
        </p>
    </div>
}
else
{
    <div class="pm-review-list pm-stagger">
        @foreach (var review in Model.Reviews)
        {
            <article class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div>
                            <span class="pm-star-row" aria-hidden="true">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <span class="@(i <= review.Rating ? "is-on" : "")">@(i <= review.Rating ? "★" : "☆")</span>
                                }
                            </span>
                            <strong class="ms-2">@review.AuthorUsername</strong>
                        </div>
                        <span class="small pm-muted">@review.CreatedUtc.ToString("d MMM yyyy")</span>
                    </div>

                    @if (review.Car is not null)
                    {
                        <div class="small pm-muted mt-1">
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@review.Car.Id">
                                @review.Car.Title
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(review.Comment))
                    {
                        <p class="mt-2 mb-0 pm-wrap">@review.Comment</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(review.SellerReply))
                    {
                        <div class="pm-review-reply mt-3">
                            <div class="small fw-semibold">
                                Your reply
                                <span class="pm-muted fw-normal">
                                    · @review.SellerRepliedUtc?.ToString("d MMM yyyy")
                                </span>
                            </div>
                            <p class="mb-0 mt-1 pm-wrap">@review.SellerReply</p>
                        </div>
                    }
                    else
                    {
                        <form asp-action="ReplyToReview" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reviewId" value="@review.Id" />
                            <label class="form-label small" for="reply-@review.Id">Reply publicly</label>
                            <div class="d-flex gap-2">
                                <input type="text" id="reply-@review.Id" name="reply" class="form-control"
                                       maxlength="1000"
                                       placeholder="Answer once, in public. It cannot be edited afterwards." />
                                <button type="submit" class="btn btn-outline-primary">Reply</button>
                            </div>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
