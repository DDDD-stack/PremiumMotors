@model Car
@{
    ViewData["Title"] = "Delete " + Model.Title;
}

<div class="pm-page-head"><h1 class="text-danger">Delete Listing</h1></div>

<div class="card overflow-hidden">
    <div class="row g-0">
        <div class="col-md-4">
            @* h-100 with no ratio produced a very tall crop once the column
               went full width on a phone. *@
            <img src="@Model.PrimaryImage" class="w-100" alt="@Model.Title"
                 style="aspect-ratio:4/3;object-fit:cover;height:100%" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <p>Are you sure you want to permanently delete this listing?</p>
                <h2 class="h5">@Model.Title</h2>
                <dl class="row small text-muted">
                    <dt class="col-4">Type</dt><dd class="col-8">@Model.Type</dd>
                    <dt class="col-4">Asking price</dt><dd class="col-8">@Model.Price.ToString("C")</dd>
                    <dt class="col-4">Mileage</dt><dd class="col-8">@Model.Mileage.ToString("N0") km</dd>
                    <dt class="col-4">Offers</dt><dd class="col-8">@Model.Offers.Count</dd>
                </dl>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-grid d-sm-flex gap-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Yes, delete</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
