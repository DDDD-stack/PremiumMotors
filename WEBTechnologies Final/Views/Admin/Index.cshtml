@model IReadOnlyList<Car>
@{
    ViewData["Title"] = L["Manage listings"].Value;
    var stats = ViewData["Stats"] as WEBTechnologies_Final.Services.CarStats;
}

<div class="pm-page-head">
    <h1>@L["Manage listings"]</h1>
    <a asp-action="Create" class="btn btn-success">@L["+ Post a car"]</a>
</div>

@if (stats is not null)
{
    <div class="row row-cols-2 row-cols-md-4 g-2 g-md-3 mb-4 pm-stagger">
        <div class="col">
            <div class="card h-100"><div class="pm-stat">
                <div class="pm-stat-value text-primary">@stats.Total</div>
                <div class="pm-stat-label">@L["Listings"]</div>
            </div></div>
        </div>
        <div class="col">
            <div class="card h-100"><div class="pm-stat">
                <div class="pm-stat-value text-success">@stats.Active</div>
                <div class="pm-stat-label">@L["Active"]</div>
            </div></div>
        </div>
        <div class="col">
            <div class="card h-100"><div class="pm-stat">
                <div class="pm-stat-value text-danger">@stats.Sold</div>
                <div class="pm-stat-label">@L["Sold"]</div>
            </div></div>
        </div>
        <div class="col">
            <div class="card h-100"><div class="pm-stat">
                <div class="pm-stat-value text-warning">@stats.PendingOffers</div>
                <div class="pm-stat-label">@L["Pending offers"]</div>
            </div></div>
        </div>
    </div>
}

@if (Model.Count == 0)
{
    <div class="pm-empty">
        <div class="pm-empty-icon" aria-hidden="true">🚗</div>
        <h2 class="h5">@L["No listings yet"]</h2>
        <p class="pm-muted mb-3">@L["Post the first car to get the marketplace started."]</p>
        <a asp-action="Create" class="btn btn-success">@L["+ Post a car"]</a>
    </div>
}
else
{
    @* Eight columns will not fit a phone. .pm-table-cards re-flows each
       row into a stacked card below md, using data-label to carry the
       column headings down with the values. *@
    <div class="table-responsive">
        <table class="table table-hover align-middle pm-table-cards">
            <thead>
                <tr>
                    <th scope="col"><span class="visually-hidden">@L["Photo"]</span></th>
                    <th scope="col">@L["Car"]</th>
                    <th scope="col">@L["Type"]</th>
                    <th scope="col">@L["Year"]</th>
                    <th scope="col">@L["Mileage"]</th>
                    <th scope="col">@L["Asking price"]</th>
                    <th scope="col">@L["Offers"]</th>
                    <th scope="col">@L["Status"]</th>
                    <th scope="col" class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td class="pm-cell-media">
                            <img src="@car.PrimaryImage" alt="@car.Title" loading="lazy" decoding="async"
                                 style="height:42px;width:64px;object-fit:cover" class="rounded" />
                        </td>
                        <td data-label="@L["Car"]">
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"
                               class="text-decoration-none fw-semibold">@car.Make @car.Model</a>
                        </td>
                        <td data-label="@L["Type"]">@L[EnumText.Display(car.Type)]</td>
                        <td data-label="@L["Year"]">@car.Year</td>
                        <td data-label="@L["Mileage"]">@L["{0} km", car.Mileage.ToString("N0")]</td>
                        <td data-label="@L["Asking price"]">@car.Price.ToString("C")</td>
                        <td data-label="@L["Offers"]">@car.Offers.Count</td>
                        <td data-label="@L["Status"]">
                            <partial name="_ListingStatusBadge" model="car.Status" />
                        </td>
                        <td class="text-end pm-cell-actions">
                            <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary">@L["Edit"]</a>
                            @if (car.Status == ListingStatus.Draft || car.Status == ListingStatus.Archived)
                            {
                                <form asp-action="Publish" asp-route-id="@car.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">@L["Publish"]</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Archive" asp-route-id="@car.Id" method="post" class="d-inline"
                                      onsubmit="return confirm(&quot;@L["Take this listing off the market?"]&quot;);">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning">@L["Archive"]</button>
                                </form>
                            }
                            <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-outline-danger">@L["Delete"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
