@model IEnumerable<Car>
@{
    ViewData["Title"] = L["Paid placement"].Value;
    var cars = Model.ToList();
    var live = cars.Count(c => c.IsPromoted);
    var frontPage = cars.Count(c => c.IsFrontPagePromoted);
    var references = ViewData["References"] as Dictionary<int, string> ?? new();
}

<div class="pm-page-head">
    <div>
        <h1>@L["Paid placement"]</h1>
        <p class="pm-muted mb-0">
            @L["Advertising is the only thing anyone pays for on this site. There is no checkout - arrange the money off-site, then grant the placement here."]
        </p>
    </div>
    <a asp-action="Promotion" class="btn btn-outline-secondary">@L["Find by reference"]</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="pm-stat">
            <span class="pm-stat-value">@live</span>
            <span class="pm-stat-label">@L["Placements running"]</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="pm-stat">
            <span class="pm-stat-value">@frontPage</span>
            <span class="pm-stat-label">@L["On the front pages"]</span>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="pm-stat">
            @* Three is what both front pages render. Selling a fourth is not blocked here,
               but it would never be seen, so the number is worth having in front of you. *@
            <span class="pm-stat-value">@(frontPage > 3 ? L["Oversold"] : L["OK"])</span>
            <span class="pm-stat-label">@L["Front page has 3 slots"]</span>
        </div>
    </div>
</div>

@if (cars.Count == 0)
{
    <div class="pm-empty">
        <h2 class="h5">@L["No active listings"]</h2>
        <p class="pm-muted mb-0">@L["Only an active listing can carry advertising."]</p>
    </div>
}
else
{
    @* pm-table-cards is what turns each row into a readable card on a phone, driven by the
       data-label attributes below. Without it those labels never render and the table is
       an unreadable squash on mobile - which is what this page had at first. *@
    <div class="table-responsive">
        <table class="table table-hover align-middle pm-table-cards">
            <thead>
                <tr>
                    <th scope="col">@L["Car"]</th>
                    <th scope="col">@L["Seller"]</th>
                    <th scope="col">@L["Reference"]</th>
                    <th scope="col">@L["Placement"]</th>
                    <th scope="col">@L["Runs until"]</th>
                    <th scope="col" class="text-end">@L["Set placement"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in cars)
                {
                    <tr>
                        <td data-label="@L["Car"]">
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id">@car.Title</a>
                            <div class="small pm-muted">@car.Price.ToString("C")</div>
                        </td>
                        @* The code the seller was given. Shown here so an admin can read it
                           off the list and quote it back, without opening the receipt. *@
                        <td data-label="@L["Reference"]">
                            @if (references.TryGetValue(car.Id, out var reference))
                            {
                                <a asp-action="Promotion" asp-route-reference="@reference"
                                   class="font-monospace small">@reference</a>
                            }
                            else
                            {
                                <span class="pm-muted small">—</span>
                            }
                        </td>
                        <td data-label="@L["Placement"]">
                            @if (car.IsPromoted)
                            {
                                <span class="badge @(car.IsFrontPagePromoted ? "bg-warning text-dark" : "bg-primary")">
                                    @(car.IsFrontPagePromoted ? L["Front page"] : L["Promoted"])
                                </span>
                            }
                            else if (car.PromotedUntilUtc is not null)
                            {
                                @* Kept rather than cleared, so a lapsed advert is still visible
                                   as something that was once sold. *@
                                <span class="badge bg-secondary">@L["Lapsed"]</span>
                            }
                            else
                            {
                                <span class="pm-muted small">—</span>
                            }
                        </td>
                        <td data-label="@L["Runs until"]">
                            @if (car.PromotedUntilUtc is DateTime until)
                            {
                                <span class="small">@AppTime.ToDisplay(until).ToString("dd MMM yyyy, HH:mm")</span>
                            }
                            else
                            {
                                <span class="pm-muted small">—</span>
                            }
                        </td>
                        <td class="text-end pm-cell-actions">
                            @* The select must open on the tier this listing already has.
                               Defaulting it to Promoted meant that extending a front-page
                               placement silently demoted it - the admin changes only the
                               days, presses the button, and quietly downgrades what somebody
                               paid for. *@
                            <form asp-action="Promote" method="post" class="d-flex gap-2 justify-content-end align-items-center flex-wrap">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@car.Id" />
                                <select name="tier" class="form-select form-select-sm w-auto" aria-label="@L["Placement tier"]">
                                    <option value="@PromotionTier.Promoted"
                                            selected="@(car.PromotionTier != PromotionTier.FrontPage)">@L["Promoted"]</option>
                                    <option value="@PromotionTier.FrontPage"
                                            selected="@(car.PromotionTier == PromotionTier.FrontPage)">@L["Front page"]</option>
                                </select>
                                <input type="number" name="days" value="30" min="1" max="365"
                                       class="form-control form-control-sm" style="width:5.5rem"
                                       aria-label="@L["Days from today"]" />
                                @* "Start" would be a lie on a row that is already running:
                                   the new end date replaces the old one rather than adding
                                   to it. *@
                                <button type="submit" class="btn btn-sm btn-primary">
                                    @(car.IsPromoted ? L["Replace"] : L["Start"])
                                </button>
                            </form>
                            @if (car.PromotedUntilUtc is not null)
                            {
                                <form asp-action="EndPromotion" method="post" class="d-inline mt-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@car.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["End now"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
