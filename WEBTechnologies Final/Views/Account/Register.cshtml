@model RegisterViewModel
@{
    ViewData["Title"] = L["Create an account"].Value;

    @* The acceptance line is ONE string with its links inside it. "I accept the" and "and"
       are not sentences, and the word order around them differs by language - Albanian puts
       the verb first and Italian agrees the article with the noun. IHtmlLocalizer renders
       the resource as markup and HTML-encodes the arguments, so the URLs go in as data. *@
    var termsUrl = Url.Action("Terms", "Home") ?? "/Home/Terms";
    var privacyUrl = Url.Action("Privacy", "Home") ?? "/Home/Privacy";
}

<div class="row justify-content-center">
    <div class="col-sm-9 col-md-7 col-lg-5">
        <div class="card mt-2 mt-md-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h1 class="h4 mb-0">@L["Personal account"]</h1>
                    <a asp-action="Signup" class="small">@L["Not you?"]</a>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autofocus
                               autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        @* type=email and inputmode swap the phone keyboard to
                           the one with @ and . on the primary layer. *@
                        <input asp-for="Email" class="form-control" type="email" inputmode="email"
                               autocomplete="email" autocapitalize="none" spellcheck="false" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" type="tel" inputmode="tel"
                               autocomplete="tel" placeholder="@L["e.g. +49 170 1234567"]" />
                        <div class="form-text">@L["Shared with a seller only when they accept your offer, so they can reach you."]</div>
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="AcceptTerms" class="form-check-input" type="checkbox" />
                        <label asp-for="AcceptTerms" class="form-check-label">
                            @L["I accept the <a href='{0}'>Terms</a> and the <a href='{1}'>Privacy Policy</a>", termsUrl, privacyUrl]
                        </label>
                        <span asp-validation-for="AcceptTerms" class="text-danger d-block"></span>
                    </div>
                    <button type="submit" class="btn btn-success w-100">@L["Create my account"]</button>
                </form>

                <p class="text-center mt-3 mb-0 small">
                    @L["Already have an account?"] <a asp-action="Login">@L["Log in"]</a><br />
                    @L["Selling as a dealer?"] <a asp-action="RegisterBusiness">@L["Register a business account"]</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
