@{
    ViewData["Title"] = L["Switch to a business account"].Value;
    var dealerships = ViewData["Dealerships"] as int? ?? 0;
    var listings = ViewData["ActiveListings"] as int? ?? 0;
}

@* The signed-in twin of /business. Same argument, different reader: this one already has
   an account, listings and possibly a rating, so the pitch is about what switching ADDS
   rather than about what the site is. *@
<section class="pm-hero pm-hero-biz pm-bleed">
    <div class="pm-hero-inner">
        <p class="pm-eyebrow">@L["For dealerships"]</p>

        <h1 class="pm-hero-title">@L["Selling more than one car?"]</h1>

        <p class="pm-hero-sub">
            @L["Switch your account to a business account and you keep everything you already have - your listings, your offers, your messages and your rating all come with you. Nothing is transferred, nothing restarts."]
        </p>

        <div class="pm-hero-cta">
            <a asp-action="BecomeBusiness" class="btn btn-lg btn-warning fw-semibold">
                @L["Switch my account"]
            </a>
            <a asp-controller="Seller" asp-action="Dashboard" class="btn btn-lg btn-outline-light">
                @L["Not now"]
            </a>
        </div>

        <p class="pm-hero-note">
            @L["Free. No commission. All we record is your NIPT and trading address."]
        </p>
    </div>
</section>

<section class="pm-section">
    <div class="pm-section-head">
        <h2>@L["What you get that you do not have now"]</h2>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["A shopfront of your own"]</h3>
                <p>
                    @L["Your logo, banner, address and opening hours on one page with a clean web address, listing every car you have. You appear in the <a href='{0}'>dealership directory</a>, which buyers browse by name and by city.", Url.Action("Index", "Dealerships") ?? "/Dealerships"]
                    @(dealerships == 1
                        ? L["1 dealership is trading there today."]
                        : L["{0} dealerships are trading there today.", dealerships])
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["Sales analytics"]</h3>
                <p>
                    @L["Revenue per month, offers per month, views over the last thirty days and a listing-by-listing table. Views per offer shows which cars are being looked at and passed over - usually a pricing problem, not a photo problem."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["A business identity on every listing"]</h3>
                <p>
                    @L["Your listings say <strong>Dealership</strong> and carry your trading name instead of your username."]
                    @(listings == 1
                        ? L["Across 1 active listing on the site, that is what tells a buyer who they are dealing with."]
                        : L["Across {0} active listings on the site, that is what tells a buyer who they are dealing with.", listings])
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["You can advertise"]</h3>
                <p>
                    @L["Paid placement is open to business accounts: a highlighted card and a slot at the top of the marketplace, or the front pages themselves. It is the only thing on this site that costs money."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["Your rating follows you"]</h3>
                <p>
                    @L["Ratings live on the account, not on the shopfront, so every review you have already earned as a private seller appears on your dealership page from day one. You do not start from zero."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["Everything you have now"]</h3>
                <p>
                    @L["Private offers, the offer inbox, messaging, stock management and 0% commission are unchanged. Switching adds; it takes nothing away."]
                </p>
            </div>
        </div>
    </div>
</section>

<section class="pm-section">
    <div class="pm-signup">
        <div class="pm-signup-col">
            <h2 class="h5">@L["Before you switch"]</h2>
            <p class="pm-muted">
                @L["Two things worth knowing, because neither is obvious and both are easier to read now than to discover afterwards."]
            </p>
            <ul class="pm-lock-list">
                <li>
                    <strong>@L["It is one way."]</strong> @L["There is no button to go back to a personal account. Ask us if you ever need to."]
                </li>
                <li>
                    <strong>@L["Your trading details become public."]</strong> @L["Your business name, town and anything you add to your dealership page - address, phone, opening hours - are shown to anyone. Your NIPT and VAT number are not."]
                </li>
            </ul>
        </div>

        <div class="pm-signup-col">
            <h2 class="h5">@L["What you will need"]</h2>
            <ol class="pm-tick-list pm-tick-num">
                <li>@L["<strong>Your NIPT</strong> - the business registration number"]</li>
                <li>@L["Registered business name and trading address"]</li>
                <li>@L["A named contact person for the account"]</li>
            </ol>
            <p class="pm-muted small">
                @L["VAT number and website are optional. We record these details; we do not check them against the business register, and no account on this site carries a verified badge."]
            </p>

            <a asp-action="BecomeBusiness" class="btn btn-lg btn-primary fw-semibold">
                @L["Switch my account"]
            </a>
        </div>
    </div>
</section>
