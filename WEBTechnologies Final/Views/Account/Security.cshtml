@model ChangePasswordViewModel
@using WEBTechnologies_Final.Models.Dtos
@{
    ViewData["Title"] = L["Security"].Value;
    var sessions = ViewData["Sessions"] as List<SessionDto> ?? new();
}

<div class="pm-page-head">
    <div>
        <h1>@L["Security"]</h1>
        <p class="pm-muted mb-0 small">@L["Your password, your signed-in devices, and your data."]</p>
    </div>
</div>

<partial name="_ProfileNav" />

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-3">@L["Change password"]</h2>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="form-text mb-3">
                        @L["Changing your password signs out every other device, which is the point of changing it after a scare."]
                    </div>

                    <button type="submit" class="btn btn-primary">@L["Change password"]</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-header">@L["Signed-in devices"]</div>
            @if (sessions.Count == 0)
            {
                <div class="card-body pm-muted small">
                    @L["No mobile or app sessions. Signing in on this website uses a browser session rather than a device token, so it does not appear here."]
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var session in sessions)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                            <div class="min-w-0">
                                <div class="fw-semibold text-truncate">@(session.Device ?? L["Unknown device"].Value)</div>
                                <div class="small pm-muted">
                                    @L["Signed in {0}", AppTime.ToDisplay(session.CreatedUtc).ToString("dd/MM/yyyy HH:mm")]
                                </div>
                            </div>
                            @if (session.IsCurrent)
                            {
                                <span class="badge bg-success flex-shrink-0">@L["This device"]</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="card">
            <div class="card-header">@L["Your data"]</div>
            <div class="card-body small">
                <h3 class="h6">@L["Download your data"]</h3>
                <p class="pm-muted">
                    @L["One file with everything we hold about your account: profile, listings, offers, messages, reviews, favourites and sign-in history."]
                </p>
                <a asp-action="ExportData" class="btn btn-outline-primary btn-sm mb-4">@L["Download my data"]</a>

                <h3 class="h6">@L["Erase your account"]</h3>
                @if (ViewData["IsAdmin"] is true)
                {
                    <p class="pm-muted mb-0">@L["An administrator account cannot be erased from this page."]</p>
                }
                else
                {
                    <p class="pm-muted">@L["This cannot be undone. What happens:"]</p>
                    <ul class="pm-muted">
                        <li>@L["Your name, email address and phone numbers are removed, and you are signed out everywhere."]</li>
                        <li>@L["Every photo you uploaded is deleted."]</li>
                        <li>@L["Completed sales stay in the sold history, without photos and without your name."]</li>
                        <li>@L["Reviews and messages you wrote stay, under an anonymous name."]</li>
                    </ul>
                    <form asp-action="DeleteAccount" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label" for="erase-password">@L["Current password"]</label>
                            <input type="password" id="erase-password" name="password" class="form-control"
                                   autocomplete="current-password" required />
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="erase-understood"
                                   name="understood" value="true" required />
                            <label class="form-check-label" for="erase-understood">
                                @L["I understand my account will be erased and this cannot be undone"]
                            </label>
                        </div>
                        <button type="submit" class="btn btn-outline-danger btn-sm">@L["Erase my account"]</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
