@using Microsoft.AspNetCore.Mvc.Rendering
@model Car

@{
    @* Html.GetEnumSelectList renders each value's [Display(Name)] in English and gives no
       way in to translate it. This builds the same list with the text put through the
       localizer, so a dropdown reads in the visitor's language like everything round it. *@
    IEnumerable<SelectListItem> Choices<T>() where T : struct, Enum =>
        Enum.GetValues<T>().Select(value => new SelectListItem
        {
            Value = value.ToString(),
            Text = L[EnumText.Display(value)].Value
        });
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />

@* Every field is col-12 on a phone and pairs up from md. The inputmode and type hints
   below decide which keyboard a phone shows, which is most of what makes a long form
   bearable on mobile. *@

<h2 class="pm-section-title mb-2">@L["The car"]</h2>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" placeholder="@L["e.g. Mercedes-Benz"]" autocapitalize="words" />
        <span asp-validation-for="Make" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" placeholder="@L["e.g. C-Class"]" autocapitalize="words" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="col-6 col-md-3">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select" asp-items="Choices<CarType>()"></select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" type="number" inputmode="numeric" min="1900" max="2100" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="Condition" class="form-label"></label>
        <select asp-for="Condition" class="form-select" asp-items="Choices<VehicleCondition>()"></select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="ExteriorColour" class="form-label"></label>
        <input asp-for="ExteriorColour" class="form-control" placeholder="@L["e.g. Obsidian black"]" autocapitalize="words" />
    </div>

    <div class="col-md-6">
        <label asp-for="Price" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">€</span>
            <input asp-for="Price" class="form-control" type="number" inputmode="decimal" step="0.01" min="0" />
        </div>
        <div class="form-text">@L["Buyers can still send you a lower offer, which you can accept or decline."]</div>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Mileage" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Mileage" class="form-control" type="number" inputmode="numeric" min="0" max="2000000" />
            <span class="input-group-text">km</span>
        </div>
        <span asp-validation-for="Mileage" class="text-danger"></span>
    </div>
</div>

<h2 class="pm-section-title mt-4 mb-2">@L["Mechanical"]</h2>
<div class="row g-3">
    <div class="col-6 col-md-3">
        <label asp-for="FuelType" class="form-label"></label>
        <select asp-for="FuelType" class="form-select" asp-items="Choices<FuelType>()"></select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="Transmission" class="form-label"></label>
        <select asp-for="Transmission" class="form-select" asp-items="Choices<TransmissionType>()"></select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="Drivetrain" class="form-label"></label>
        <select asp-for="Drivetrain" class="form-select" asp-items="Choices<DrivetrainType>()"></select>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="EngineSizeCc" class="form-label"></label>
        <input asp-for="EngineSizeCc" class="form-control" type="number" inputmode="numeric" placeholder="@L["e.g. 1991"]" />
        <span asp-validation-for="EngineSizeCc" class="text-danger"></span>
    </div>

    <div class="col-6 col-md-3">
        <label asp-for="PowerHp" class="form-label"></label>
        <input asp-for="PowerHp" class="form-control" type="number" inputmode="numeric" placeholder="@L["e.g. 194"]" />
        <span asp-validation-for="PowerHp" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="Doors" class="form-label"></label>
        <input asp-for="Doors" class="form-control" type="number" inputmode="numeric" min="1" max="7" />
        <span asp-validation-for="Doors" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="Seats" class="form-label"></label>
        <input asp-for="Seats" class="form-control" type="number" inputmode="numeric" min="1" max="9" />
        <span asp-validation-for="Seats" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="PreviousOwners" class="form-label"></label>
        <input asp-for="PreviousOwners" class="form-control" type="number" inputmode="numeric" min="0" max="20" />
        <span asp-validation-for="PreviousOwners" class="text-danger"></span>
    </div>
</div>

<h2 class="pm-section-title mt-4 mb-2">@L["History &amp; paperwork"]</h2>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="ServiceHistory" class="form-label"></label>
        <select asp-for="ServiceHistory" class="form-select"
                asp-items="Choices<ServiceHistoryLevel>()"></select>
        <div class="form-text">@L["Documented servicing is the first thing most buyers filter on."]</div>
    </div>
    <div class="col-md-6">
        <label asp-for="FirstRegistration" class="form-label"></label>
        <input asp-for="FirstRegistration" class="form-control" type="date"
               value="@(Model.FirstRegistration?.ToString("yyyy-MM-dd"))" />
        <div class="form-text">@L["Often later than the model year."]</div>
    </div>

    <div class="col-12">
        <label asp-for="ServiceHistoryNotes" class="form-label"></label>
        <textarea asp-for="ServiceHistoryNotes" class="form-control" rows="3"
                  placeholder="@L["e.g. Serviced at 15k/30k/45k at main dealer. Timing belt replaced 2024. New tyres front."]"></textarea>
        <span asp-validation-for="ServiceHistoryNotes" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Vin" class="form-label"></label>
        <input asp-for="Vin" class="form-control" autocapitalize="characters" spellcheck="false"
               placeholder="@L["Optional"]" />
        @* The VIN is stored but never published: it identifies a specific vehicle and is
           worth scraping. Buyers are told one exists and can ask for it in the chat. *@
        <div class="form-text">@L["Stored privately. Buyers see only that you recorded one - share it in chat."]</div>
        <span asp-validation-for="Vin" class="text-danger"></span>
    </div>
    <div class="col-md-6 d-flex align-items-center">
        <div class="form-check mt-md-4">
            <input asp-for="HasAccidentHistory" class="form-check-input" type="checkbox" />
            <label asp-for="HasAccidentHistory" class="form-check-label"></label>
            <div class="form-text">@L["Declare it up front - a buyer who finds out later walks away."]</div>
        </div>
    </div>
</div>

<h2 class="pm-section-title mt-4 mb-2">@L["Location &amp; description"]</h2>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Country" class="form-label"></label>
        <input asp-for="Country" class="form-control" placeholder="@L["e.g. Albania"]" autocapitalize="words" />
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" placeholder="@L["e.g. Tirana"]" autocapitalize="words" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"
                  placeholder="@L["Condition, options, recent work, why you are selling..."]"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label class="form-label" for="photos">@L["Photos"]</label>
        @* capture is deliberately omitted: offering the camera *and* the gallery is what a
           seller photographing a car actually wants. *@
        <input type="file" id="photos" name="photos" class="form-control" accept="image/*" multiple />
        <div class="form-text">
            @L["JPEG, PNG, GIF or WebP. Select as many as you like at once - up to 12 per listing. Large photos are resized in your browser before they are sent, so this works on mobile data."]
        </div>

        @if (Model.ImagePaths.Count > 0)
        {
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="form-label mb-0">@L["Current photos ({0})", Model.ImagePaths.Count]</span>
                    <span class="small pm-muted">@L["The first photo is the cover image."]</span>
                </div>

                @* Removal is an explicit per-photo checkbox rather than a full replacement
                   list, so an edit that uploads nothing keeps every existing photo. The
                   checkbox posts the path; the controller drops it and deletes the blob. *@
                <div class="pm-photo-grid">
                    @for (var i = 0; i < Model.ImagePaths.Count; i++)
                    {
                        var path = Model.ImagePaths[i];
                        var inputId = "removePhoto_" + i;

                        <div class="pm-photo">
                            <img src="@path" alt="@L["Photo {0}", i + 1]" loading="lazy" decoding="async" />
                            @if (i == 0)
                            {
                                <span class="pm-photo-cover">@L["Cover"]</span>
                            }
                            <input class="pm-photo-check" type="checkbox" id="@inputId"
                                   name="removePhotos" value="@path" />
                            <label class="pm-photo-remove" for="@inputId">
                                <span aria-hidden="true">✕</span>
                                <span class="visually-hidden">@L["Remove photo {0}", i + 1]</span>
                            </label>
                        </div>
                    }
                </div>
                <div class="form-text">
                    @L["Tick ✕ on any photo to remove it when you save. New uploads are added to the end."]
                </div>
            </div>
        }
    </div>
</div>
