@model WEBTechnologies_Final.Models.Car
@{
    var userId = Context.Session.GetInt32(WEBTechnologies_Final.Services.SessionKeys.UserId);
    var loggedIn = userId is not null;
    var isFav = ViewData["IsFav_" + Model.Id] is true;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var extra = ViewData["FavBtnClass"] as string ?? "";
}

@if (loggedIn)
{
    @* display:contents keeps the form out of the flex/grid layout so the
       button lines up with its siblings as if the form were not there. *@
    <form asp-controller="Favorites" asp-action="Toggle" method="post" style="display:contents">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <button type="submit"
                class="btn @(isFav ? "btn-danger" : "btn-outline-danger") @extra"
                aria-pressed="@(isFav ? "true" : "false")"
                title="@(isFav ? L["Remove from favourites"] : L["Save to favourites"])">
            @(isFav ? L["♥ Saved"] : L["♡ Favourite"])
        </button>
    </form>
}
else
{
    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"
       class="btn btn-outline-danger @extra" title="@L["Log in to save favourites"]">
        @L["♡ Favourite"]
    </a>
}
