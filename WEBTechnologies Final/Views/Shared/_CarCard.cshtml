@using WEBTechnologies_Final.Services.Marketplace
@model Car
@{
    @* Shared by the browse grid and the favourites grid so the two can never drift apart.
       view-transition-name pairs this photo with the hero image on the detail page, which
       is what makes the card appear to expand into the listing. *@
    var favClass = ViewData["FavBtnClass"] as string ?? "btn-sm";

    @* Seller identity and price history come from ListingExtrasService, built once for the
       whole page. A page that does not supply them renders exactly as before rather than
       failing - the byline is extra information, not part of the card's contract. *@
    var sellers = ViewData["SellerBadges"] as IReadOnlyDictionary<int, SellerBadge>;
    var drops = ViewData["PriceDrops"] as IReadOnlyDictionary<int, decimal>;

    SellerBadge? seller = null;
    if (sellers != null && Model.OwnerId is int ownerId) sellers.TryGetValue(ownerId, out seller);

    decimal? wasPrice = null;
    if (drops != null && drops.TryGetValue(Model.Id, out var high)) wasPrice = high;

    @* Paid placement is read off the listing itself rather than passed in, so a promoted car
       looks promoted everywhere it appears - the marketplace strip, the results grid, the
       front pages and the dealership page - without every caller having to remember. *@
    var promoted = Model.IsPromoted;
}

<div class="card h-100 car-card @(promoted ? "is-promoted" : "")">
    <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id"
       class="car-thumb pm-media" aria-label="@L["View {0}", Model.Title]">
        <img src="@Model.PrimaryImage" alt="@Model.Title" loading="lazy" decoding="async"
             style="view-transition-name: car-photo-@Model.Id" />
        @if (Model.Status != ListingStatus.Active)
        {
            @* A small pill in the corner was far too easy to miss: a sold car and an
               available one looked near enough identical while scanning a grid, which is
               exactly when it matters. The photo is now dimmed and drained of colour and
               the status is written across it, so the state of a listing is legible at a
               glance rather than on inspection. *@
            <span class="pm-status-wash pm-status-@Model.Status.ToString().ToLowerInvariant()"
                  aria-hidden="true"></span>
            <span class="pm-status-band pm-status-@Model.Status.ToString().ToLowerInvariant()">
                <partial name="_ListingStatusBadge" model="Model.Status" />
            </span>
        }
        @if (Model.Status == ListingStatus.Active && wasPrice != null)
        {
            <span class="pm-badge-float pm-badge-drop">@L["Price drop"]</span>
        }
        @if (promoted)
        {
            @* Labelled, not disguised. Paid placement that does not say it is paid is an
               advert pretending to be a search result, and in most of Europe that is also
               illegal. The label is the cheap part; the prominence is what was bought. *@
            <span class="pm-badge-promoted" title="@L["The seller paid for this placement"]">
                @L["Promoted"]
            </span>
        }
    </a>
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
            <h3 class="h6 mb-0 car-title">
                <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
            </h3>
            <span class="badge bg-secondary flex-shrink-0">@L[EnumText.Display(Model.Type)]</span>
        </div>

        @* The spec line replaces the old description snippet: mileage, fuel and gearbox are
           what a buyer scans a results grid for. *@
        <ul class="pm-spec-line">
            <li>@Model.Mileage.ToString("N0") km</li>
            <li>@L[EnumText.Display(Model.FuelType)]</li>
            <li>@L[EnumText.Display(Model.Transmission)]</li>
            @if (!string.IsNullOrWhiteSpace(Model.City))
            {
                <li>@Model.City</li>
            }
        </ul>

        @if (seller != null)
        {
            <div class="mb-2">
                <partial name="_SellerByline" model="seller"
                         view-data='new ViewDataDictionary(ViewData) { ["BylineCompact"] = true }' />
            </div>
        }

        <div class="mt-auto">
            <div class="small pm-muted">@L["Asking price"]</div>
            <div class="pm-price mb-2">
                @Model.Price.ToString("C")
                @if (wasPrice is decimal was)
                {
                    <span class="pm-price-was" title="@L["Reduced from {0}", was.ToString("C")]">
                        @was.ToString("C")
                    </span>
                }
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.Id"
                   class="btn btn-sm btn-primary flex-grow-1">@L["View"]</a>
                <partial name="_FavoriteButton" model="Model"
                         view-data='new ViewDataDictionary(ViewData) { ["FavBtnClass"] = favClass }' />
            </div>
        </div>
    </div>
</div>
