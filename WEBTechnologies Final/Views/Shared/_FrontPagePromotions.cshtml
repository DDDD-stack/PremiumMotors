@model IReadOnlyList<Car>
@{
    @* The top advertising tier, shared by both front pages so the two can never drift.
       Renders nothing at all when nobody has bought the slot - an empty "Featured" band with
       a placeholder in it advertises that we have no advertisers. *@
    if (Model.Count == 0) { return; }

    var heading = ViewData["PromoHeading"] as string ?? L["Featured this week"].Value;
}

<section class="pm-section pm-promoted-front pm-reveal" aria-label="@L["Advertised listings"]">
    <div class="pm-section-head pm-section-head-row">
        <div>
            <h2>@heading</h2>
            @* Says "advertisement" in plain words. Paid placement dressed as an editorial
               pick is a dark pattern, and across the EU it is also unlawful. *@
            <p class="pm-muted mb-0">
                @L["Advertisement — these sellers paid for this space."]
            </p>
        </div>
        <a asp-controller="Home" asp-action="ForBusiness" class="btn btn-sm btn-outline-primary d-none d-md-inline-block">
            @L["Advertise here"]
        </a>
    </div>

    <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-3 pm-stagger">
        @foreach (var car in Model)
        {
            <div class="col">
                <partial name="_CarCard" model="car" />
            </div>
        }
    </div>
</section>
