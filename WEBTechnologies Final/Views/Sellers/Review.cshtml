@model LeaveReviewViewModel
@{
    ViewData["Title"] = L["Review {0}", Model.SellerName].Value;
}

<div class="pm-page-head">
    <div>
        <h1>@L["How was it?"]</h1>
        <p class="pm-muted mb-0 small">
            @L["Your review appears on the public profile of {0}, under your username.", Model.SellerName]
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Review" asp-route-carId="@Model.CarId" method="post" class="card shadow-sm">
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="CarId" />

                <fieldset class="mb-4">
                    <legend class="form-label">@L["Your rating"]</legend>

                    @* Radio buttons rather than a JavaScript star widget: it works with the
                       keyboard, it works with a screen reader, and it works with JavaScript
                       off. The CSS turns it into stars. *@
                    <div class="pm-star-input">
                        @for (var i = 5; i >= 1; i--)
                        {
                            var id = "star" + i;
                            <input type="radio" asp-for="Rating" value="@i" id="@id" />
                            <label for="@id" title="@L["{0} out of 5", i]">
                                <span aria-hidden="true">★</span>
                                <span class="visually-hidden">@(i == 1 ? L["1 star"] : L["{0} stars", i])</span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </fieldset>

                <div class="mb-3">
                    <label asp-for="Comment" class="form-label"></label>
                    <textarea asp-for="Comment" class="form-control" rows="5"
                              placeholder="@L["Was the car as described? How was the seller to deal with?"]"></textarea>
                    <div class="form-text">
                        @L["Optional, but a rating with a sentence behind it is worth far more to the next buyer than a bare number."]
                    </div>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@L["Post review"]</button>
                    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Purchases">@L["Cancel"]</a>
                </div>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm pm-sticky-aside">
            <div class="card-body">
                <h2 class="pm-section-title mb-3">@L["What you bought"]</h2>
                <div class="d-flex gap-3">
                    <span class="pm-review-thumb pm-media">
                        <img src="@Model.CarImage" alt="" loading="lazy" decoding="async" />
                    </span>
                    <div>
                        <div class="fw-semibold">@Model.CarTitle</div>
                        <div class="small pm-muted">
                            @L["from {0}", Model.SellerName]
                            (@(Model.SellerIsDealer ? L["Dealership"] : L["Private seller"]))
                        </div>
                        @if (Model.SoldPrice is decimal price)
                        {
                            <div class="pm-price mt-2">@price.ToString("C")</div>
                        }
                        @if (Model.SoldUtc is DateTime when)
                        {
                            <div class="small pm-muted">@when.ToString("d MMMM yyyy")</div>
                        }
                    </div>
                </div>
                <p class="small pm-muted mt-3 mb-0">
                    @L["You can review a seller once per car you bought from them. Reviews cannot be edited afterwards, so take a moment over it."]
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
