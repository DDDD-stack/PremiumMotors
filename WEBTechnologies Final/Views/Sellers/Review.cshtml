@model LeaveReviewViewModel
@{
    ViewData["Title"] = "Review " + Model.SellerName;
}

<div class="pm-page-head">
    <div>
        <h1>How was it?</h1>
        <p class="pm-muted mb-0 small">
            Your review appears on @Model.SellerName's public profile, under your username.
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <form asp-action="Review" asp-route-carId="@Model.CarId" method="post" class="card shadow-sm">
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="CarId" />

                <fieldset class="mb-4">
                    <legend class="form-label">Your rating</legend>

                    @* Radio buttons rather than a JavaScript star widget: it works with the
                       keyboard, it works with a screen reader, and it works with JavaScript
                       off. The CSS turns it into stars. *@
                    <div class="pm-star-input">
                        @for (var i = 5; i >= 1; i--)
                        {
                            var id = "star" + i;
                            <input type="radio" asp-for="Rating" value="@i" id="@id" />
                            <label for="@id" title="@i out of 5">
                                <span aria-hidden="true">★</span>
                                <span class="visually-hidden">@i star@(i == 1 ? "" : "s")</span>
                            </label>
                        }
                    </div>
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </fieldset>

                <div class="mb-3">
                    <label asp-for="Comment" class="form-label"></label>
                    <textarea asp-for="Comment" class="form-control" rows="5"
                              placeholder="Was the car as described? How was the seller to deal with?"></textarea>
                    <div class="form-text">
                        Optional, but a rating with a sentence behind it is worth far more to
                        the next buyer than a bare number.
                    </div>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Post review</button>
                    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Purchases">Cancel</a>
                </div>
            </div>
        </form>
    </div>

    <div class="col-lg-5">
        <div class="card shadow-sm pm-sticky-aside">
            <div class="card-body">
                <h2 class="pm-section-title mb-3">What you bought</h2>
                <div class="d-flex gap-3">
                    <span class="pm-review-thumb pm-media">
                        <img src="@Model.CarImage" alt="" loading="lazy" decoding="async" />
                    </span>
                    <div>
                        <div class="fw-semibold">@Model.CarTitle</div>
                        <div class="small pm-muted">
                            from @Model.SellerName
                            (@(Model.SellerIsDealer ? "dealership" : "private seller"))
                        </div>
                        @if (Model.SoldPrice is decimal price)
                        {
                            <div class="pm-price mt-2">@price.ToString("C")</div>
                        }
                        @if (Model.SoldUtc is DateTime when)
                        {
                            <div class="small pm-muted">@when.ToString("d MMMM yyyy")</div>
                        }
                    </div>
                </div>
                <p class="small pm-muted mt-3 mb-0">
                    You can review a seller once per car you bought from them. Reviews cannot
                    be edited afterwards, so take a moment over it.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
