@model Car
@{
    ViewData["Title"] = Model.Title;

    var currentUserId = Context.Session.GetInt32(SessionKeys.UserId);
    var currentUser = Context.Session.GetString(SessionKeys.Username);
    var isSeller = ViewData["IsSeller"] is true;
    var myOffer = ViewData["MyOffer"] as Offer;
    var myThreadId = ViewData["MyConversationId"] as int?;
    var threads = ViewData["Threads"] as Dictionary<int, int> ?? new();
    // True when the signed-in viewer is the buyer whose offer the seller accepted.
    var isWinningBuyer = currentUserId is not null && Model.SoldToUserId == currentUserId;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    var images = Model.ImagePaths.Count > 0 ? Model.ImagePaths : new List<string> { Model.PrimaryImage };

    var sellerBadge = ViewData["SellerBadge"] as SellerBadge;
    var wasPrice = ViewData["PreviousPrice"] as decimal?;
    var similar = ViewData["Similar"] as List<Car> ?? new();
    var recentlyViewed = ViewData["RecentlyViewed"] as List<Car> ?? new();
    var priceHistory = ViewData["PriceHistory"] as List<CarPriceChange> ?? new();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-action="Index">@L["Cars for sale"]</a></li>
        <li class="breadcrumb-item active text-truncate" style="max-width:60vw" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="row g-3 g-lg-4">

    <div class="col-lg-7">
        <div id="carGallery" class="carousel slide card overflow-hidden" data-bs-ride="false">
            <div class="carousel-inner">
                @for (var i = 0; i < images.Count; i++)
                {
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        @* Only the first photo carries the transition name: it is the one the
                           grid card morphs into, and a name may appear once per document. *@
                        <div class="pm-media">
                            <img src="@images[i]" class="d-block w-100 detail-img" alt="@Model.Title"
                                 loading="@(i == 0 ? "eager" : "lazy")" decoding="async"
                                 @(i == 0 ? Html.Raw($"style=\"view-transition-name: car-photo-{Model.Id}\"") : null) />
                            @* Same treatment as the grid card. The sidebar already says a car
                               is sold, but somebody who arrives on a shared link looks at the
                               photo first and may never reach the sidebar on a phone. *@
                            @if (Model.Status != ListingStatus.Active)
                            {
                                <span class="pm-status-wash pm-status-@Model.Status.ToString().ToLowerInvariant()"
                                      aria-hidden="true"></span>
                                <span class="pm-status-band pm-status-band-lg pm-status-@Model.Status.ToString().ToLowerInvariant()">
                                    <partial name="_ListingStatusBadge" model="Model.Status" />
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (images.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#carGallery" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@L["Previous photo"]</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carGallery" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">@L["Next photo"]</span>
                </button>
                <div class="carousel-indicators">
                    @for (var i = 0; i < images.Count; i++)
                    {
                        <button type="button" data-bs-target="#carGallery" data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")" aria-label="@L["Photo {0}", i + 1]"></button>
                    }
                </div>
            }
        </div>

        <div class="card mt-3 mt-lg-4">
            <div class="card-body">
                <h2 class="h5 mb-3">@L["Specification"]</h2>
                <div class="pm-spec-grid">
                    <dl class="pm-spec-item"><dt>@L["Mileage"]</dt><dd>@Model.Mileage.ToString("N0") km</dd></dl>
                    <dl class="pm-spec-item"><dt>@L["Fuel"]</dt><dd>@L[EnumText.Display(Model.FuelType)]</dd></dl>
                    <dl class="pm-spec-item"><dt>@L["Gearbox"]</dt><dd>@L[EnumText.Display(Model.Transmission)]</dd></dl>
                    <dl class="pm-spec-item"><dt>@L["Drivetrain"]</dt><dd>@L[EnumText.Display(Model.Drivetrain)]</dd></dl>
                    <dl class="pm-spec-item"><dt>@L["Year"]</dt><dd>@Model.Year</dd></dl>
                    <dl class="pm-spec-item"><dt>@L["Condition"]</dt><dd>@L[EnumText.Display(Model.Condition)]</dd></dl>
                    @if (Model.EngineSizeCc is int cc)
                    {
                        <dl class="pm-spec-item"><dt>@L["Engine"]</dt><dd>@cc.ToString("N0") cc</dd></dl>
                    }
                    @if (Model.PowerHp is int hp)
                    {
                        <dl class="pm-spec-item"><dt>@L["Power"]</dt><dd>@hp @L["hp"]</dd></dl>
                    }
                    @if (Model.Doors is int doors)
                    {
                        <dl class="pm-spec-item"><dt>@L["Doors"]</dt><dd>@doors</dd></dl>
                    }
                    @if (Model.Seats is int seats)
                    {
                        <dl class="pm-spec-item"><dt>@L["Seats"]</dt><dd>@seats</dd></dl>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ExteriorColour))
                    {
                        <dl class="pm-spec-item"><dt>@L["Colour"]</dt><dd>@Model.ExteriorColour</dd></dl>
                    }
                    @if (Model.PreviousOwners is int owners)
                    {
                        <dl class="pm-spec-item"><dt>@L["Previous owners"]</dt><dd>@owners</dd></dl>
                    }
                    @if (Model.FirstRegistration is DateTime reg)
                    {
                        <dl class="pm-spec-item"><dt>@L["First registered"]</dt><dd>@reg.ToString("MM/yyyy")</dd></dl>
                    }
                    <dl class="pm-spec-item"><dt>@L["Service history"]</dt><dd>@L[EnumText.Display(Model.ServiceHistory)]</dd></dl>
                    <dl class="pm-spec-item">
                        <dt>@L["Accident history"]</dt>
                        <dd>@(Model.HasAccidentHistory ? L["Declared"] : L["None declared"])</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(Model.Vin))
                    {
                        @* The VIN itself is never rendered — only that the seller recorded one. *@
                        <dl class="pm-spec-item"><dt>@L["VIN"]</dt><dd>@L["On file — ask the seller"]</dd></dl>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ServiceHistoryNotes))
                {
                    <h3 class="h6 mt-4">@L["Service record"]</h3>
                    <p class="mb-0 pm-break" style="white-space: pre-line">@Model.ServiceHistoryNotes</p>
                }
            </div>
        </div>

        <div class="card mt-3 mt-lg-4">
            <div class="card-body">
                <h2 class="h5">@L["Description"]</h2>
                <p class="mb-0 pm-break" style="white-space: pre-line">@Model.Description</p>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="pm-sticky-aside">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h1 class="h4 mb-2">@Model.Title</h1>
                        <partial name="_ListingStatusBadge" model="Model.Status" />
                    </div>

                    <ul class="pm-spec-line mb-3">
                        <li>@Model.Mileage.ToString("N0") km</li>
                        <li>@L[EnumText.Display(Model.FuelType)]</li>
                        <li>@L[EnumText.Display(Model.Transmission)]</li>
                        <li>@Model.Country@(string.IsNullOrWhiteSpace(Model.City) ? "" : " · " + Model.City)</li>
                    </ul>

                    <div class="pm-price-box mb-3 d-flex justify-content-between align-items-center">
                        <span class="pm-muted small">@L["Asking price"]</span>
                        <span class="text-end">
                            <span class="fw-bold text-primary fs-4">@Model.Price.ToString("C")</span>
                            @if (wasPrice is decimal was)
                            {
                                <span class="d-block small">
                                    <span class="pm-price-was">@was.ToString("C")</span>
                                    <span class="pm-drop-amount">
                                        &minus;@((was - Model.Price).ToString("C"))
                                    </span>
                                </span>
                            }
                        </span>
                    </div>

                    @if (sellerBadge is not null)
                    {
                        <div class="pm-byline-box mb-3">
                            <partial name="_SellerByline" model="sellerBadge" />
                        </div>
                    }

                    @if (Model.ViewCount > 0)
                    {
                        <p class="small pm-muted mb-3">
                            @(Model.ViewCount == 1 ? L["1 view"] : L["{0} views", Model.ViewCount.ToString("N0")])
                        </p>
                    }

                    @if (Model.Status == ListingStatus.Sold)
                    {
                        <div class="alert @(isWinningBuyer ? "alert-success" : "alert-secondary") mb-3">
                            <strong>
                                @(isWinningBuyer ? L["You bought this car."] : L["This car has been sold."])
                            </strong>
                            @if ((isSeller || isWinningBuyer) && Model.SoldPrice is decimal sp)
                            {
                                <div class="small">
                                    @(isSeller ? L["Agreed at {0} with {1}.", sp.ToString("C"), Model.SoldTo ?? string.Empty] : L["Agreed at {0}.", sp.ToString("C")])
                                </div>
                            }
                        </div>
                    }
                    else if (Model.Status == ListingStatus.Reserved)
                    {
                        @if (isWinningBuyer)
                        {
                            <div class="alert alert-success mb-3">
                                <strong>@L["Your offer was accepted."]</strong>
                                <div class="small">
                                    @if (Model.SoldPrice is decimal agreed)
                                    {
                                        <text>@L["Agreed at {0}.", agreed.ToString("C")] </text>
                                    }
                                    @L["Contact the seller below to arrange payment and collection."]
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-3">
                                <strong>@L["Reserved."]</strong>
                                <div class="small">
                                    @L["The seller has accepted an offer and is completing the sale."]
                                </div>
                            </div>
                        }
                        @if (isSeller)
                        {
                            <div class="d-grid gap-2 mb-3">
                                <form asp-controller="Seller" asp-action="MarkSold" method="post">
                                    <input type="hidden" name="carId" value="@Model.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-success w-100">@L["Mark as sold"]</button>
                                </form>
                                <form asp-controller="Seller" asp-action="Reopen" method="post">
                                    <input type="hidden" name="carId" value="@Model.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-outline-secondary w-100">
                                        @L["Sale fell through — relist"]
                                    </button>
                                </form>
                            </div>
                        }
                    }
                    else if (isSeller)
                    {
                        <div class="alert alert-info mb-3">
                            @L["This is your listing. Offers from buyers appear below."]
                        </div>
                    }
                    else if (string.IsNullOrEmpty(currentUser))
                    {
                        <div class="alert alert-warning">
                            <strong>@L["Log in to make an offer."]</strong>
                            <div class="small">
                                @L["Offers, written messages and favourites need a free account."]
                                @if (Model.Status == ListingStatus.Active && ViewData["ListingPhone"] is not null)
                                {
                                    <text>@L["Or just ring the seller on the number below."]</text>
                                }
                            </div>
                        </div>
                        <div class="d-grid gap-2 mb-3">
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl"
                               class="btn btn-primary">@L["Log in to make an offer"]</a>
                            <a asp-controller="Account" asp-action="Signup" class="btn btn-outline-primary">
                                @L["Create an account"]
                            </a>
                        </div>
                    }
                    else if (myOffer is not null && myOffer.IsPending)
                    {
                        @* The buyer already has an offer in. Showing the form again would only
                           let them stack duplicates on the seller's inbox. *@
                        <div class="alert alert-primary mb-3">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <strong>@L["Your offer: {0}", myOffer.Amount.ToString("C")]</strong>
                                <partial name="_OfferStatusBadge" model="myOffer.Status" />
                            </div>
                            <div class="small mt-1">@L["The seller can accept, decline, or message you first."]</div>
                        </div>
                        <form asp-action="WithdrawOffer" method="post" class="d-grid mb-3">
                            <input type="hidden" name="offerId" value="@myOffer.Id" />
                            <input type="hidden" name="carId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@L["Withdraw my offer"]</button>
                        </form>
                    }
                    else
                    {
                        @if (myOffer is not null)
                        {
                            <div class="alert alert-secondary mb-3">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <span>@L["Your last offer: {0}", myOffer.Amount.ToString("C")]</span>
                                    <partial name="_OfferStatusBadge" model="myOffer.Status" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(myOffer.SellerResponse))
                                {
                                    <div class="small mt-1 fst-italic">&ldquo;@myOffer.SellerResponse&rdquo;</div>
                                }
                            </div>
                        }

                        <form asp-action="Offer" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <label class="form-label" for="offerAmount">@L["Make an offer"]</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text">€</span>
                                <input type="number" id="offerAmount" name="amount" class="form-control"
                                       step="0.01" min="1" inputmode="decimal"
                                       value="@Model.Price" required />
                            </div>
                            <label class="form-label small" for="offerMessage">@L["Add a note (optional)"]</label>
                            <textarea id="offerMessage" name="message" class="form-control mb-2" rows="2"
                                      maxlength="1000"
                                      placeholder="@L["e.g. Can collect this weekend, cash ready."]"></textarea>
                            <button type="submit" class="btn btn-primary w-100">@L["Send offer"]</button>
                            <div class="form-text">
                                @L["Private to the seller. A note starts a chat so they can ask you questions."]
                            </div>
                        </form>
                    }

                    <div class="d-grid gap-2">
                        @* The seller's published number. This is the one contact route that
                           does not need an account, so for a signed-out visitor it is the
                           primary action and gets the solid button. Signed in, offering and
                           messaging are better routes, so it steps back to an outline.

                           ACTIVE ONLY. A sold or reserved listing stays browsable, but
                           inviting someone to ring about a car that is already gone wastes
                           their time and the seller's. Same rule as paid placement. *@
                        @if (!isSeller
                             && Model.Status == ListingStatus.Active
                             && ViewData["ListingPhone"] is string listingPhone)
                        {
                            var guest = string.IsNullOrEmpty(currentUser);
                            <a href="tel:@listingPhone"
                               class="btn @(guest ? "btn-success" : "btn-outline-secondary")">
                                📞 @L["Call the seller"] — @listingPhone
                            </a>
                        }

                        @if (!isSeller && !string.IsNullOrEmpty(currentUser))
                        {
                            @if (myThreadId is int tid)
                            {
                                <a asp-controller="Messages" asp-action="Thread" asp-route-id="@tid"
                                   class="btn btn-outline-primary">💬 @L["Open chat with the seller"]</a>
                            }
                            else
                            {
                                <form asp-action="StartChat" method="post" class="d-grid">
                                    <input type="hidden" name="carId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-outline-primary">
                                        💬 @L["Message the seller"]
                                    </button>
                                </form>
                            }
                        }
                        <partial name="_FavoriteButton" model="Model"
                                 view-data='new ViewDataDictionary(ViewData) { ["FavBtnClass"] = "w-100" }' />
                        <a asp-action="Share" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100">
                            🔗 @L["Share this listing"]
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (isWinningBuyer && ViewData["SellerEmail"] is string sellerEmail)
        {
            <div class="card mt-3 mt-lg-4 border-success">
                <div class="card-header bg-success text-white">@L["Seller contact details"]</div>
                <div class="card-body">
                    <p class="small pm-muted mb-2">
                        @L["The seller accepted your offer. Arrange inspection, payment and handover directly — PremiumMotors does not handle the money."]
                    </p>
                    <dl class="row small mb-0 pm-break">
                        <dt class="col-4">@L["Seller"]</dt><dd class="col-8">@ViewData["SellerName"]</dd>
                        <dt class="col-4">@L["Email"]</dt><dd class="col-8"><a href="mailto:@sellerEmail">@sellerEmail</a></dd>
                        @if (ViewData["SellerPhone"] is string sellerPhone && !string.IsNullOrWhiteSpace(sellerPhone))
                        {
                            <dt class="col-4">@L["Phone"]</dt><dd class="col-8"><a href="tel:@sellerPhone">@sellerPhone</a></dd>
                        }
                        @if (Model.SoldPrice is decimal myPrice)
                        {
                            <dt class="col-4">@L["Agreed price"]</dt><dd class="col-8">@myPrice.ToString("C")</dd>
                        }
                    </dl>
                    @if (myThreadId is int chatId)
                    {
                        <a asp-controller="Messages" asp-action="Thread" asp-route-id="@chatId"
                           class="btn btn-sm btn-outline-primary mt-3">💬 @L["Continue the chat"]</a>
                    }
                </div>
            </div>
        }

        @if (isSeller && Model.SoldToUserId is not null && ViewData["BuyerEmail"] is string buyerEmail)
        {
            <div class="card mt-3 mt-lg-4 border-success">
                <div class="card-header bg-success text-white">@L["Buyer contact details"]</div>
                <div class="card-body">
                    <p class="small pm-muted mb-2">
                        @L["You accepted this buyer's offer. Arrange inspection, payment and handover directly — the sale happens between you and the buyer."]
                    </p>
                    <dl class="row small mb-0 pm-break">
                        <dt class="col-4">@L["Buyer"]</dt><dd class="col-8">@Model.SoldTo</dd>
                        <dt class="col-4">@L["Email"]</dt><dd class="col-8"><a href="mailto:@buyerEmail">@buyerEmail</a></dd>
                        @if (ViewData["BuyerPhone"] is string buyerPhone && !string.IsNullOrWhiteSpace(buyerPhone))
                        {
                            <dt class="col-4">@L["Phone"]</dt><dd class="col-8"><a href="tel:@buyerPhone">@buyerPhone</a></dd>
                        }
                        @if (Model.SoldPrice is decimal agreed)
                        {
                            <dt class="col-4">@L["Agreed price"]</dt><dd class="col-8">@agreed.ToString("C")</dd>
                        }
                    </dl>
                </div>
            </div>
        }

        @* Offers are private: only the seller (or an admin) ever sees this card. A buyer sees
           their own offer in the panel above and nothing about anyone else's. *@
        @if (isSeller)
        {
            var pending = Model.Offers.Where(o => o.Status == OfferStatus.Pending)
                                      .OrderByDescending(o => o.Amount).ToList();
            var answered = Model.Offers.Where(o => o.Status != OfferStatus.Pending)
                                       .OrderByDescending(o => o.CreatedUtc).ToList();

            <div class="card mt-3 mt-lg-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@L["Offers ({0})", Model.Offers.Count]</span>
                    @if (pending.Count > 0)
                    {
                        <span class="badge bg-primary">@L["{0} awaiting reply", pending.Count]</span>
                    }
                </div>

                @if (Model.Offers.Count == 0)
                {
                    <div class="card-body pm-muted small">
                        @L["No offers yet. Buyers can send you a private offer from this page."]
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var offer in pending.Concat(answered))
                        {
                            var threadId = offer.BuyerId is int bid && threads.TryGetValue(bid, out var t)
                                ? (int?)t : null;

                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <div class="fw-semibold text-truncate">@offer.BuyerUsername</div>
                                        <div class="small pm-muted">
                                            @AppTime.ToDisplay(offer.CreatedUtc).ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="text-end flex-shrink-0">
                                        <div class="pm-price">@offer.Amount.ToString("C")</div>
                                        <partial name="_OfferStatusBadge" model="offer.Status" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(offer.Message))
                                {
                                    <p class="small mt-2 mb-0 fst-italic pm-break">&ldquo;@offer.Message&rdquo;</p>
                                }

                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    @* Chat before deciding: the seller can ask about collection,
                                       payment method or a viewing before committing. *@
                                    @if (threadId is int existing)
                                    {
                                        <a asp-controller="Messages" asp-action="Thread" asp-route-id="@existing"
                                           class="btn btn-sm btn-outline-primary">💬 @L["Chat"]</a>
                                    }
                                    else if (offer.BuyerId is int buyerId)
                                    {
                                        <form asp-action="StartChat" method="post" class="d-inline">
                                            <input type="hidden" name="carId" value="@Model.Id" />
                                            <input type="hidden" name="buyerId" value="@buyerId" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">💬 @L["Chat"]</button>
                                        </form>
                                    }

                                    @if (offer.Status == OfferStatus.Pending)
                                    {
                                        <form asp-controller="Seller" asp-action="AcceptOffer" method="post" class="d-inline">
                                            <input type="hidden" name="offerId" value="@offer.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="btn btn-sm btn-success">@L["Accept"]</button>
                                        </form>
                                        <form asp-controller="Seller" asp-action="DeclineOffer" method="post" class="d-inline">
                                            <input type="hidden" name="offerId" value="@offer.Id" />
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@L["Decline"]</button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        }
    </div>
</div>

@* One change is already worth showing: it is the difference between "17,500" and
   "17,500, down from 20,000 last week", which is the whole reason to keep the table. *@
@if (priceHistory.Count > 0)
{
    <section class="card shadow-sm mt-4">
        <div class="card-body">
            <h2 class="pm-section-title mb-3">@L["Price history"]</h2>
            <ul class="pm-price-history">
                @foreach (var change in priceHistory)
                {
                    <li>
                        <span class="pm-history-date">@change.ChangedUtc.ToString("d MMM yyyy")</span>
                        <span class="pm-history-price">@change.Price.ToString("C")</span>
                        @if (change.PreviousPrice is decimal prev)
                        {
                            var down = change.Price < prev;
                            <span class="pm-history-delta @(down ? "is-down" : "is-up")">
                                @(down ? "↓" : "↑") @Math.Abs(change.Price - prev).ToString("C")
                            </span>
                        }
                        else
                        {
                            <span class="pm-muted small">@L["listed"]</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </section>
}

@if (similar.Count > 0)
{
    <section class="mt-5">
        <div class="pm-page-head">
            <div>
                <h2 class="h5 mb-0">@L["Similar cars"]</h2>
                <p class="pm-muted small mb-0">@L["Same body type, around the same money."]</p>
            </div>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 g-md-4 pm-stagger">
            @foreach (var car in similar)
            {
                <div class="col"><partial name="_CarCard" model="car" /></div>
            }
        </div>
    </section>
}

@if (recentlyViewed.Count > 0)
{
    <section class="mt-5">
        <div class="pm-page-head">
            <div>
                <h2 class="h5 mb-0">@L["Recently viewed"]</h2>
                <p class="pm-muted small mb-0">@L["Cars you looked at earlier in this visit."]</p>
            </div>
        </div>
        <div class="row row-cols-2 row-cols-xl-4 g-3 pm-stagger">
            @foreach (var car in recentlyViewed)
            {
                <div class="col"><partial name="_CarCard" model="car" /></div>
            }
        </div>
    </section>
}
