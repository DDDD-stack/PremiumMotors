@model Car
@{
    ViewData["Title"] = L["Share {0}", Model.Title].Value;
    var url = ViewData["ListingUrl"] as string ?? "";
    var encodedUrl = Uri.EscapeDataString(url);
    var encodedText = Uri.EscapeDataString(L["Check out this {0} on PremiumMotors!", Model.Title].Value);
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card overflow-hidden">
            <div class="pm-media">
                <img src="@Model.PrimaryImage" class="card-img-top detail-img" alt="@Model.Title" decoding="async" />
            </div>
            <div class="card-body">
                <h1 class="h4">@L["Share “{0}”", Model.Title]</h1>
                <p class="pm-muted">@L["Asking price:"] <strong>@Model.Price.ToString("C")</strong></p>

                @* On a phone this opens the OS share sheet — WhatsApp,
                   Messages, AirDrop and everything else the device has.
                   site.js hides the button where navigator.share is
                   missing, leaving the explicit links below as the path. *@
                <button type="button" class="btn btn-primary w-100 mb-3"
                        data-pm-share="@url" data-pm-share-title="@Model.Title">
                    📤 @L["Share…"]
                </button>

                <label class="form-label" for="shareUrl">@L["Listing link"]</label>
                <div class="input-group mb-3">
                    <input type="text" id="shareUrl" class="form-control" value="@url" readonly />
                    <button class="btn btn-outline-secondary" type="button" data-pm-copy="#shareUrl">@L["Copy"]</button>
                </div>

                <div class="row row-cols-2 row-cols-sm-4 g-2">
                    <div class="col d-grid">
                        <a class="btn btn-outline-primary"
                           href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl" target="_blank" rel="noopener">Facebook</a>
                    </div>
                    <div class="col d-grid">
                        <a class="btn btn-outline-info"
                           href="https://twitter.com/intent/tweet?url=@encodedUrl&text=@encodedText" target="_blank" rel="noopener">X</a>
                    </div>
                    <div class="col d-grid">
                        <a class="btn btn-outline-success"
                           href="https://wa.me/?text=@encodedText%20@encodedUrl" target="_blank" rel="noopener">WhatsApp</a>
                    </div>
                    <div class="col d-grid">
                        <a class="btn btn-outline-secondary"
                           href="mailto:?subject=@Uri.EscapeDataString(Model.Title)&body=@encodedText%20@encodedUrl">Email</a>
                    </div>
                </div>

                <hr />
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link px-0">&larr; @L["Back to listing"]</a>
            </div>
        </div>
    </div>
</div>
