@model CarListViewModel
@{
    ViewData["Title"] = "Cars for sale";
    var activeFilters = Model.ActiveFilterCount;
}

<div class="pm-page-head">
    <div>
        <h1>Cars for sale</h1>
        @* Sold cars are no longer browsable, but reserved ones are, so the count still is
           not a count of cars anyone can walk up and buy today. "Listings" keeps the
           heading and the number from disagreeing. *@
        <p class="pm-muted mb-0 small">
            @Model.TotalCount listing@(Model.TotalCount == 1 ? "" : "s")
            @if (Model.TotalPages > 1)
            {
                <text>· page @Model.Page of @Model.TotalPages</text>
            }
        </p>
    </div>
</div>

@* Small screens get a toggle that expands the filters inline, above the results.
   Leaving the whole panel permanently open pushed every listing off the first
   screen; a slide-in drawer fixed that but made the page feel like an app. *@
<div class="pm-filter-bar">
    <button class="btn btn-outline-secondary flex-grow-1" type="button"
            data-bs-toggle="collapse" data-bs-target="#filterPanel"
            aria-expanded="false" aria-controls="filterPanel">
        Search &amp; filter
        @if (activeFilters > 0)
        {
            <span class="pm-filter-count">@activeFilters</span>
        }
    </button>
    @if (Model.HasActiveFilters)
    {
        <a asp-action="Index" class="btn btn-link text-decoration-none">Clear</a>
    }
</div>

<div class="row g-4">
    <div class="col-lg-3">
        @* One form, two presentations: collapsed behind a toggle on small screens,
           always visible as a sidebar from lg up (d-lg-block wins over .collapse). *@
        <div class="collapse d-lg-block" id="filterPanel">
            <form asp-action="Index" method="get" class="card w-100 pm-filter-rail">
                    <div class="card-body">
                        <h2 class="pm-section-title d-none d-lg-block mb-3">Search &amp; filter</h2>

                        <div class="mb-3">
                            <label class="form-label" for="search">Search</label>
                            <input type="search" id="search" name="search" value="@Model.Search"
                                   class="form-control" placeholder="Make, model, keyword..." />
                        </div>

                        <div class="row g-2">
                            <div class="col-6 col-lg-12 mb-lg-3">
                                <label class="form-label" for="type">Type</label>
                                <select id="type" name="type" class="form-select" asp-items="Model.TypeOptions">
                                    <option value="">Any type</option>
                                </select>
                            </div>
                            <div class="col-6 col-lg-12 mb-lg-3">
                                <label class="form-label" for="make">Make</label>
                                <select id="make" name="make" class="form-select" asp-items="Model.MakeOptions">
                                    <option value="">Any make</option>
                                </select>
                            </div>
                            <div class="col-6 col-lg-12 mb-lg-3">
                                <label class="form-label" for="model">Model</label>
                                <select id="model" name="model" class="form-select" asp-items="Model.ModelOptions">
                                    <option value="">Any model</option>
                                </select>
                            </div>
                            <div class="col-6 col-lg-12 mb-lg-3">
                                <label class="form-label" for="year">Model Year</label>
                                <select id="year" name="year" class="form-select" asp-items="Model.YearOptions">
                                    <option value="">Any year</option>
                                </select>
                            </div>
                            <div class="col-6 col-lg-12 mb-lg-3">
                                <label class="form-label" for="fuel">Fuel</label>
                                <select id="fuel" name="fuel" class="form-select" asp-items="Model.FuelOptions">
                                    <option value="">Any fuel</option>
                                </select>
                            </div>
                            <div class="col-6 col-lg-12 mb-lg-3">
                                <label class="form-label" for="gearbox">Gearbox</label>
                                <select id="gearbox" name="gearbox" class="form-select" asp-items="Model.GearboxOptions">
                                    <option value="">Any gearbox</option>
                                </select>
                            </div>

                            <div class="col-12 mb-lg-3">
                                <label class="form-label">Price (EUR)</label>
                                <div class="input-group">
                                    <input type="number" name="minPrice" value="@Model.MinPrice"
                                           class="form-control" placeholder="Min" inputmode="numeric" min="0" />
                                    <span class="input-group-text">–</span>
                                    <input type="number" name="maxPrice" value="@Model.MaxPrice"
                                           class="form-control" placeholder="Max" inputmode="numeric" min="0" />
                                </div>
                            </div>

                            <div class="col-12 mb-lg-3">
                                <label class="form-label" for="maxMileage">Max mileage</label>
                                <div class="input-group">
                                    <input type="number" id="maxMileage" name="maxMileage" value="@Model.MaxMileage"
                                           class="form-control" placeholder="Any" inputmode="numeric" min="0" />
                                    <span class="input-group-text">km</span>
                                </div>
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label" for="sortBy">Sort by</label>
                                <select id="sortBy" name="sortBy" class="form-select" asp-items="Model.SortOptions"></select>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-2">
                            <button type="submit" class="btn btn-primary">Apply</button>
                            @if (Model.HasActiveFilters)
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear filters</a>
                            }
                        </div>
                    </div>
            </form>
        </div>
    </div>

    <div class="col-lg-9">
        @* Adverts are mixed into the results rather than fenced off above them, so this note
           replaces the old block heading as the disclosure. Every promoted card still carries
           its own "Promoted" badge - this just says it once in words, up front. *@
        @if (Model.PromotedOnPage > 0)
        {
            @* Say exactly what the money buys. "Position only, never inclusion" is the honest
               and checkable version: a promoted car still has to match the filters to appear
               at all, so paying can move a car up but can never put a diesel estate in front
               of somebody who asked for petrol hatchbacks. *@
            <p class="pm-promoted-note mb-3">
                Some listings on this page are marked
                <span class="pm-promoted-note-badge">Promoted</span> — those sellers paid for a
                higher position on the first page. They still have to match your filters to
                show up at all, and paying never changes a car's price, mileage or condition.
                <a asp-action="Featured">See them on their own page</a>.
            </p>
        }

        @if (Model.Cars.Count == 0)
        {
            <div class="pm-empty">
                <div class="pm-empty-icon" aria-hidden="true">🔎</div>
                <h2 class="h5">No cars match your search</h2>
                <p class="pm-muted mb-3">Try raising your budget, allowing more mileage, or clearing a filter.</p>
                @if (Model.HasActiveFilters)
                {
                    <a asp-action="Index" class="btn btn-primary">Clear all filters</a>
                }
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 g-md-4 pm-stagger">
                @foreach (var car in Model.Cars)
                {
                    <div class="col">
                        <partial name="_CarCard" model="car" />
                    </div>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Listing pages" class="mt-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                    <div class="small pm-muted order-2 order-sm-1">
                        Showing @(((Model.Page - 1) * Model.PageSize) + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                        of @Model.TotalCount listings
                    </div>
                    <ul class="pagination mb-0 order-1 order-sm-2">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-type="@Model.Type"
                               asp-route-make="@Model.Make"
                               asp-route-model="@Model.Model"
                               asp-route-year="@Model.Year"

                               asp-route-minPrice="@Model.MinPrice"

                               asp-route-maxPrice="@Model.MaxPrice"

                               asp-route-maxMileage="@Model.MaxMileage"

                               asp-route-fuel="@Model.Fuel"

                               asp-route-gearbox="@Model.Gearbox"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-page="@(Model.Page - 1)">‹ Prev</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">@Model.Page / @Model.TotalPages</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-type="@Model.Type"
                               asp-route-make="@Model.Make"
                               asp-route-model="@Model.Model"
                               asp-route-year="@Model.Year"

                               asp-route-minPrice="@Model.MinPrice"

                               asp-route-maxPrice="@Model.MaxPrice"

                               asp-route-maxMileage="@Model.MaxMileage"

                               asp-route-fuel="@Model.Fuel"

                               asp-route-gearbox="@Model.Gearbox"
                               asp-route-sortBy="@Model.SortBy"
                               asp-route-page="@(Model.Page + 1)">Next ›</a>
                        </li>
                    </ul>
                </div>
            </nav>
        }
    </div>
</div>
