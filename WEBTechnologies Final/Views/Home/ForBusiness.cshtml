@model BusinessLandingViewModel
@{
    ViewData["Title"] = L["PremiumMotors for dealerships"].Value;
    var stats = Model.Stats;
}

@* ---------------------------------------------------------------------------
   Same three entry points as the consumer page: hero button (which doubles as
   the scroll anchor for the header button), and the stock strip lower down.
   The argument is different though - a dealer is buying a sales channel.
   --------------------------------------------------------------------------- *@
<section class="pm-hero pm-hero-biz pm-bleed">
    <div class="pm-hero-inner pm-stagger">
        <p class="pm-eyebrow">@L["For dealerships"]</p>

        <h1 class="pm-hero-title">@L["Stop discounting in public."]</h1>

        <p class="pm-hero-sub">
            @L["Every buyer who walks your forecourt already knows your lowest advertised price — because you advertised it. Here, buyers come to you with a number instead, one at a time, in private. You keep the margin you would otherwise have posted on a banner."]
        </p>

        <div class="pm-hero-cta">
            <a asp-controller="Account" asp-action="RegisterBusiness"
               class="btn btn-lg btn-warning fw-semibold pm-cta-main" data-pm-cta-anchor>
                @L["Register your dealership — free"]
            </a>
            <a asp-controller="Cars" asp-action="Index" class="btn btn-lg btn-outline-light">
                @L["Browse the marketplace"]
            </a>
        </div>

        <p class="pm-hero-note">
            @L["No listing fees. 0% commission. The only thing you can pay for is advertising."]
        </p>

        @if (stats.WorthShowing)
        {
            <dl class="pm-stat-strip">
                <div><dt>0%</dt><dd>@L["commission on a sale"]</dd></div>
                <div><dt>@stats.DealershipCount</dt><dd>@L["dealerships trading"]</dd></div>
                <div><dt>@stats.ActiveListings</dt><dd>@L["cars listed"]</dd></div>
                <div><dt>@stats.SoldCount</dt><dd>@L["sold through the site"]</dd></div>
            </dl>
        }
    </div>
</section>

@* The same premium slot as the consumer page. Showing it here is deliberate: a dealer
   reading this page is being shown exactly what the top tier buys, using cars that
   somebody actually paid to put there. *@
<partial name="_FrontPagePromotions" model="Model.Promoted"
         view-data='new ViewDataDictionary(ViewData) { ["PromoHeading"] = L["What the top tier looks like"].Value }' />

@* --------------------------------------------------------------------------- *@
<section class="pm-section pm-reveal">
    <div class="pm-section-head">
        <h2>@L["Where the money is"]</h2>
        <p class="pm-muted">@L["Three things that change when offers are private."]</p>
    </div>

    <div class="row g-4 pm-stagger">
        <div class="col-md-4">
            <div class="pm-idea-card">
                <span class="pm-idea-num">01</span>
                <h3 class="h6">@L["Your floor stays yours"]</h3>
                <p>
                    @L["On a classifieds site the advertised price is the ceiling and everyone negotiates down from it. Here a buyer has to name a number first, and plenty of them name one you would not have asked for."]
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pm-idea-card">
                <span class="pm-idea-num">02</span>
                <h3 class="h6">@L["You are never forced to take the highest"]</h3>
                <p>
                    @L["Accept the buyer who is financed, local and ready — not just the one waving the biggest number. Declining costs you nothing and the listing stays live."]
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pm-idea-card">
                <span class="pm-idea-num">03</span>
                <h3 class="h6">@L["You find out what a car is really worth"]</h3>
                <p>
                    @L["Ten private offers on a car is ten independent valuations. Price the next one from evidence instead of from what the dealer down the road is asking."]
                </p>
            </div>
        </div>
    </div>
</section>

@* --------------------------------------------------------------------------- *@
<section class="pm-section pm-reveal">
    <div class="pm-section-head">
        <h2>@L["The tools you get"]</h2>
        <p class="pm-muted">@L["All of it included, from the day you register."]</p>
    </div>

    <div class="row g-4 pm-stagger">
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["A shopfront of your own"]</h3>
                <p>
                    @L["Your logo, banner, address, opening hours and every car you have, on one page with a clean address you can print on a business card. Buyers browse the"]
                    <a asp-controller="Dealerships" asp-action="Index">@L["dealership directory"]</a>
                    @L["by name and by city, not just by car."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["Sales analytics"]</h3>
                <p>
                    @L["Revenue per month, offers per month, views over the last thirty days, and a listing-by-listing table. Views per offer tells you which cars are being looked at and passed over — usually a pricing problem, not a photo problem."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["One inbox for every offer"]</h3>
                <p>
                    @L["Offers arrive in your panel with the buyer attached. Accept with a note, decline with a reason, or open a conversation first. Accepting one declines the rest automatically and reserves the car."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["Stock management"]</h3>
                <p>
                    @L["Draft, active, reserved, sold and archived — move a car between them in one click. Relist an unsold car without retyping it. Every price change is recorded, so your own history is auditable."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["A reputation you can point at"]</h3>
                <p>
                    @L["Only a buyer who completed a purchase from you can leave a rating, so the score on your shopfront is worth something. It shows on every listing you put up."]
                </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="pm-why">
                <h3 class="h6">@L["Messaging with a record"]</h3>
                <p>
                    @L["Every conversation is tied to the car it is about and kept in one thread, so a handover six weeks later is not an argument about who said what."]
                </p>
            </div>
        </div>
    </div>
</section>

@* ---------------------------------------------------------------------------
   Registration, spelled out. A dealer's first question is what it costs and
   what we will ask them for, so both get answered before the CTA.
   --------------------------------------------------------------------------- *@
<section class="pm-section pm-reveal">
    <div class="pm-signup">
        <div class="pm-signup-col">
            <h2 class="h4">@L["Registering is free. Selling is free."]</h2>
            <p class="pm-muted">
                @L["There is no plan to pick, no trial to start and nothing to cancel. Commission is 0% — the sale happens directly between you and the buyer, and we take no part of it, ever."]
            </p>
            <p class="pm-muted">
                @L["The one thing you can pay us for is"] <a href="#advertising">@L["advertising"]</a>:
                @L["buying a more prominent place for a car than it would earn on its own. Nothing else on this site costs money, and a listing that is not promoted is not penalised — it just is not advertised."]
            </p>
            @* Careful with this paragraph. There is no verification anywhere in the app and
               no plan for one, so it must not hint that a check happens or is coming. The
               previous wording ended "...until we do", which promised exactly that. *@
            <p class="pm-muted mb-0">
                @L["We ask for a registration number so that a business account is tied to a real registered business rather than to an address somebody made up this morning. We record it with your account and nothing else: we do not check it against any register, and no listing on this site carries a verified badge."]
            </p>
        </div>

        <div class="pm-signup-col">
            <h2 class="h5">@L["What you will need"]</h2>
            <ol class="pm-tick-list pm-tick-num">
                <li><strong>@L["Your NIPT"]</strong> — @L["the business registration number"]</li>
                <li>@L["Registered business name and trading address"]</li>
                <li>@L["A named contact person for the account"]</li>
                <li>@L["An email address and a phone number"]</li>
            </ol>
            <p class="pm-muted small">@L["VAT number and website are optional and can be added later."]</p>

            <a asp-controller="Account" asp-action="RegisterBusiness" class="btn btn-lg btn-primary fw-semibold">
                @L["Register your dealership"]
            </a>
            <p class="small pm-muted mt-2 mb-0">
                @L["Already have a business account?"]
                <a asp-controller="Account" asp-action="Login">@L["Log in"]</a>.
            </p>
        </div>
    </div>
</section>

@* ---------------------------------------------------------------------------
   The rate card. Deliberately the only place on the site where money is asked
   for, and it names what each tier physically does rather than selling
   "visibility" - a dealer can check every claim here against the marketplace.
   --------------------------------------------------------------------------- *@
<section id="advertising" class="pm-section pm-reveal">
    <div class="pm-section-head">
        <h2>@L["Advertising — the only thing that costs money"]</h2>
        <p class="pm-muted">
            @L["Two placements. Each one is a real, visible change to where your car appears, and every advertised car is labelled as advertised."]
        </p>
    </div>

    <div class="row g-4 pm-stagger">
        <div class="col-md-6">
            <div class="pm-tier">
                <div class="pm-tier-head">
                    <h3 class="h6 mb-0">@L["Promoted listing"]</h3>
                </div>
                <ul class="pm-tick-list">
                    <li>@L["A highlighted card everywhere the car appears"]</li>
                    <li>@L["A place near the top of the first page of results, mixed in with the free listings rather than fenced off above them"]</li>
                    <li>@L["A slot on"] <a asp-controller="Cars" asp-action="Featured">@L["Ready to deal"]</a>,
                        @L["the page of currently promoted cars"]</li>
                    <li>@L["Follows the buyer's filters, so it shows to people already looking for a car like yours"]</li>
                </ul>
                <p class="small pm-muted mb-0">
                    @L["Best for a car that is getting views and no offers, where the problem is position rather than price."]
                </p>
            </div>
        </div>

        <div class="col-md-6">
            <div class="pm-tier pm-tier-top">
                <div class="pm-tier-head">
                    <h3 class="h6 mb-0">@L["Front page"]</h3>
                    <span class="pm-tier-flag">@L["Most expensive"]</span>
                </div>
                <ul class="pm-tick-list">
                    <li>@L["Everything in a promoted listing"]</li>
                    <li>@L["A slot on both front pages — the buyers' one and this one — directly beneath the headline"]</li>
                    <li>@L["Seen before a visitor has decided what they are looking for, which is the only inventory on the site that can do that"]</li>
                </ul>
                <p class="small pm-muted mb-0">
                    @L["Three slots at a time, on purpose. The moment it becomes a wall of cars it stops being worth buying."]
                </p>
            </div>
        </div>
    </div>

    @* No prices, because none are set and inventing them here would be the one lie on an
       otherwise checkable page. There is no checkout either - see the pre-release checklist. *@
    <p class="pm-muted small mt-4 mb-0">
        @L["Placements are arranged with us directly for now — there is no self-service checkout yet, and rates are not published. Every promotion runs for a fixed period and then lapses on its own; nothing renews without you asking. You are sent a reference for each one so you can quote it if you ever need to ask us about it."]
    </p>
</section>

@* --------------------------------------------------------------------------- *@
@if (Model.Dealerships.Count > 0)
{
    <section class="pm-section pm-reveal">
        <div class="pm-section-head pm-section-head-row">
            <div>
                <h2>@L["Dealerships already trading here"]</h2>
                <p class="pm-muted mb-0">@L["Every business account gets a page like these."]</p>
            </div>
            <a asp-controller="Dealerships" asp-action="Index" class="btn btn-outline-primary d-none d-md-inline-block">
                @L["See the directory"]
            </a>
        </div>

        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-4 pm-stagger">
            @foreach (var dealer in Model.Dealerships)
            {
                <div class="col">
                    <a class="pm-dealer-mini" asp-controller="Dealerships" asp-action="Details"
                       asp-route-slug="@dealer.Slug">
                        <img src="@dealer.Logo" alt="" width="56" height="56" loading="lazy" />
                        <span class="pm-dealer-mini-name">@dealer.Name</span>
                        @if (!string.IsNullOrWhiteSpace(dealer.Location))
                        {
                            <span class="pm-dealer-mini-meta">@dealer.Location</span>
                        }
                        <span class="pm-dealer-mini-meta">
                            @L["{0} in stock", dealer.ListingCount]
                            @if (dealer.RatingCount > 0)
                            {
                                <text>· @dealer.RatingAverage.ToString("0.0") ★</text>
                            }
                        </span>
                    </a>
                </div>
            }
        </div>
    </section>
}

@* --------------------------------------------------------------------------- *@
<section class="pm-band pm-bleed pm-reveal">
    <div class="pm-band-inner">
        <div>
            <h2 class="h4 mb-1">@L["Selling one car, not a forecourt?"]</h2>
            <p class="mb-0">
                @L["A personal account lists a car just as well, and costs nothing either."]
            </p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-lg btn-warning fw-semibold flex-shrink-0">
            @L["PremiumMotors for buyers and sellers"]
        </a>
    </div>
</section>
