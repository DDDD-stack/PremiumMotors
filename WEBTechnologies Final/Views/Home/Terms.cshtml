@{
    ViewData["Title"] = "Terms of Service";

    @* The version shown here MUST match LegalDocuments.Version, which is what registration
       stores against each account. A stored version that matches nothing published looks
       like proof and is not. Change the two together, in the same commit, and only when the
       SUBSTANCE changes - a typo fix is not a new version. *@
    var version = LegalDocuments.Version;
    var privacyUrl = Url.Action("Privacy", "Home") ?? "/Home/Privacy";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h1 class="h3 mb-1">Terms of Service</h1>
        <p class="text-muted">
            Version: @version · Last updated: 16 September 2026
        </p>

        <p class="small text-muted">
            Published in English. Albanian and Italian versions are being prepared; section 34
