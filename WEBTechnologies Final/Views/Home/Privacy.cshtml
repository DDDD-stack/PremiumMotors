@using System.Globalization
@{
    ViewData["Title"] = L["Privacy Policy"].Value;

    @* Legal text is kept as whole documents per language rather than as hundreds of
       translation keys: a lawyer or a native reader needs to review each language as one
       document, top to bottom, and a sentence split into fragments cannot be checked that way.

       English governs. ?lang=en shows the English original from any language, so a reader of
       a translation is always one click from the text that decides. *@
    var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var forceEnglish = string.Equals(Context.Request.Query["lang"], "en", StringComparison.OrdinalIgnoreCase);
    var body = forceEnglish || (language != "sq" && language != "it") ? "en" : language;
    var englishUrl = Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), new { lang = "en" });
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <h1 class="h3 mb-1">@(body == "en" ? "Privacy Policy" : L["Privacy Policy"].Value)</h1>
        <p class="text-muted">
            @if (body == "en")
            {
                <text>Version: @LegalDocuments.Version · Last updated: 16 September 2026</text>
            }
            else
            {
                @L["Version: {0}", LegalDocuments.Version] <text>·</text> @L["Last updated: 16 September 2026"]
            }
        </p>

        @if (body != "en")
        {
            <div class="alert alert-light border small">
                @L["This is a translation. If it differs from the English version, the <a href='{0}'>English version</a> governs.", englishUrl ?? ""]
            </div>
        }

        <partial name="Legal/_Privacy.@(body)" />
    </div>
</div>
