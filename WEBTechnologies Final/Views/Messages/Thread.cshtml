@model Conversation
@{
    ViewData["Title"] = "Chat · " + (Model.Car?.Title ?? "Listing");
    var viewerId = (int)ViewData["ViewerId"]!;
    var viewerRole = ViewData["ViewerRole"] as string ?? "buyer";
}

<div class="pm-chat">
    <div class="pm-chat-head card">
        <div class="card-body d-flex align-items-center gap-3 py-2">
            <a asp-controller="Messages" asp-action="Index" class="btn btn-sm btn-outline-secondary flex-shrink-0"
               aria-label="Back to messages">←</a>
            <a asp-controller="Cars" asp-action="Details" asp-route-id="@Model.CarId"
               class="d-flex align-items-center gap-2 text-decoration-none min-w-0 flex-grow-1">
                <img src="@(Model.Car?.PrimaryImage ?? "/img/no-image.svg")" alt=""
                     class="pm-thread-thumb" loading="lazy" />
                <span class="min-w-0">
                    <span class="fw-semibold d-block text-truncate">@(Model.Car?.Title ?? "Listing")</span>
                    <span class="small pm-muted">
                        @(Model.Car is not null ? Model.Car.Price.ToString("C") : "")
                        · @(viewerRole == "buyer" ? "You are buying" : "You are selling")
                    </span>
                </span>
            </a>
        </div>
    </div>

    <div class="pm-chat-log" id="chatLog">
        @if (Model.Messages.Count == 0)
        {
            <div class="pm-chat-empty">
                <p class="pm-muted small mb-0">
                    No messages yet. Ask about the service history, a viewing, or how payment
                    would work.
                </p>
            </div>
        }
        else
        {
            foreach (var message in Model.Messages)
            {
                var mine = message.SenderId == viewerId;
                <div class="pm-bubble-row @(mine ? "is-mine" : "")">
                    <div class="pm-bubble">
                        @if (!mine)
                        {
                            <div class="pm-bubble-sender">@message.SenderUsername</div>
                        }
                        <div class="pm-break">@message.Body</div>
                        <div class="pm-bubble-time">
                            @AppTime.ToDisplay(message.SentUtc).ToString("dd/MM HH:mm")
                            @if (mine && message.ReadUtc is not null)
                            {
                                <span title="Read">· seen</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (Model.IsClosed)
    {
        <div class="alert alert-secondary mb-0 mt-2">
            This conversation is closed because the car has been sold.
        </div>
    }
    else
    {
        <form asp-action="Send" asp-route-id="@Model.Id" method="post" class="pm-chat-compose">
            @Html.AntiForgeryToken()
            <label class="visually-hidden" for="body">Message</label>
            <textarea id="body" name="body" class="form-control" rows="1" maxlength="2000"
                      placeholder="Write a message…" required autocomplete="off"></textarea>
            <button type="submit" class="btn btn-primary">Send</button>
        </form>
    }
</div>

@section Scripts {
    <script>
        // Jump to the newest message on load. Delivery is request-response for now, so this
        // is the whole of "scroll to bottom" behaviour a realtime client would do on push.
        (function () {
            var log = document.getElementById('chatLog');
            if (log) { log.scrollTop = log.scrollHeight; }

            // Grow the composer with the message instead of scrolling a one-line box.
            var box = document.getElementById('body');
            if (box) {
                var grow = function () {
                    box.style.height = 'auto';
                    box.style.height = Math.min(box.scrollHeight, 160) + 'px';
                };
                box.addEventListener('input', grow);
                grow();
            }
        })();
    </script>
}
