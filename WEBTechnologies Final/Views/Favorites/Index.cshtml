@model IReadOnlyList<Car>
@{
    ViewData["Title"] = "My Favourites";
}

<div class="pm-page-head">
    <div>
        <h1>♥ My Favourites</h1>
        <p class="pm-muted mb-0 small">@Model.Count saved listing@(Model.Count == 1 ? "" : "s")</p>
    </div>
    <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-primary">Browse cars</a>
</div>

@if (Model.Count == 0)
{
    <div class="pm-empty">
        <div class="pm-empty-icon" aria-hidden="true">♡</div>
        <h2 class="h5">Nothing saved yet</h2>
        <p class="pm-muted mb-3">Tap <strong>♡ Favourite</strong> on any car to keep it here.</p>
        <a asp-controller="Cars" asp-action="Index" class="btn btn-primary">Find a car</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-3 g-md-4 pm-stagger">
        @foreach (var car in Model)
        {
            <div class="col">
                <partial name="_CarCard" model="car"
                         view-data='new ViewDataDictionary(ViewData) { ["FavBtnClass"] = "btn-sm" }' />
            </div>
        }
    </div>
}
