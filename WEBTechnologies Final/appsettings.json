{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ==========================================================================
  // SECRETS ARE DELIBERATELY EMPTY HERE.
  // Local dev  : dotnet user-secrets set "Key:Path" "value"
  // Production : environment variables, with __ for the colon
  //              e.g. ConnectionStrings__DefaultConnection
  // Full walkthrough: docs/SUPABASE_SETUP.md and docs/PRODUCTION-CHECKLIST.md
  // ==========================================================================

  "ConnectionStrings": {
    // Supabase session pooler. SECRET. Accepts either the ADO.NET or the postgres:// URI form.
    "DefaultConnection": ""
  },

  "App": {
    // Absolute base URL of the deployed site. Used to build absolute image URLs for the
    // mobile app. Leave empty locally to fall back to the incoming request.
    "PublicBaseUrl": "",

    // Everything is STORED in UTC; this is only the zone users see times in.
    "DisplayTimeZone": "Central European Standard Time"
  },

  "Database": {
    // Applies migrations on boot. Convenient locally; set false in production and run
    // "dotnet ef database update" as an explicit deploy step instead.
    "AutoMigrate": true
  },

  "Jwt": {
    "Issuer": "PremiumMotors",
    "Audience": "PremiumMotors.Clients",
    // SECRET. Minimum 32 bytes; the app refuses to start without it.
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },

  "Cors": {
    // Browser origins allowed to call the API. Native mobile apps ignore CORS entirely.
    // MUST be set in production - an empty list falls back to allow-any-origin.
    "AllowedOrigins": [ "http://localhost:5084", "https://localhost:7007" ]
  },

  "Storage": {
    // "Local" writes to wwwroot/uploads (DEVELOPMENT ONLY - cloud hosts wipe that on deploy).
    // "Supabase" uploads to Supabase Storage and returns absolute public URLs.
    "Provider": "Local",
    "SupabaseUrl": "https://euynxyqdxovnzsxvisan.supabase.co",
    // SECRET - the service_role key. Never ship it to a browser or a mobile bundle.
    "SupabaseServiceKey": "",
    "Bucket": "car-photos",
    "MaxFileBytes": 8388608,
    "MaxFilesPerListing": 12
  },

  "Email": {
    // Resend (https://resend.com). Without these, password-reset emails are only LOGGED.
    "ApiKey": "",
    "From": "PremiumMotors <no-reply@example.com>",
    // Base URL for links inside emails. Falls back to App:PublicBaseUrl behaviour if empty.
    "PublicBaseUrl": ""
  },

  "Swagger": {
    // Development always has Swagger. Set true only if you deliberately want it in production.
    "EnabledInProduction": false
  },

  "AdminSeed": {
    "Username": "admin",
    "Email": "admin@premiummotors.local",
    // SECRET. In Development this defaults to "admin123"; in Production a random password is
    // generated and written to the log if this is not set.
    "Password": ""
  },

  // Listings are FREE (ListingFeeCents = 0): they publish immediately and no payment provider
  // is involved. Monetization moves to paid daily boosts funded by wallet top-ups -
  // see docs/MONETIZATION.md. A non-zero value re-enables the old listing-fee flow.
  "Listing": {
    "ListingFeeCents": 0,
    "Currency": "eur",
    "MaxFreeRelists": 3
  },

  "PayPal": {
    // Unused while listings are free. SECRETS when you do enable payments.
    "ClientId": "",
    "Secret": "",
    "Mode": "sandbox",
    "WebhookId": "",
    "BrandName": "PremiumMotors"
  }
}
